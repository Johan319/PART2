	}
	local function emit(node, indent)
		local cls = CLASSES[node.class]
		local pad = string.rep("	", indent)
		local anim = node.animate or node.animation
		local animArg = (type(anim) == "string" and anim ~= "") and string.format("%q", anim) or "nil"
		local parts = { pad .. 'make("' .. node.class .. '", {' }
		for _, def in ipairs(cls.props) do
			local val = node.props[def.name]
			if val ~= nil then
				parts[#parts + 1] = pad .. "	" .. def.name .. " = " .. luaLiteral(def, val) .. ","
			end
		end
		if #node.children == 0 then
			parts[#parts + 1] = pad .. "}, nil, " .. animArg .. ")"
		else
			parts[#parts + 1] = pad .. "}, {"
			for _, ch in ipairs(node.children) do parts[#parts + 1] = emit(ch, indent + 1) .. "," end
			parts[#parts + 1] = pad .. "}, " .. animArg .. ")"
		end
		return table.concat(parts, "\n")
	end
	local scripts = {}
	local function clean(node, path)
		local copy = { class = node.class, props = node.props, children = {}, animate = node.animate }
		local myPath = path .. "." .. tostring(node.props.Name or node.class)
		for _, ch in ipairs(node.children) do
			local c = CLASSES[ch.class]
			if c and c.proxy then
				scripts[#scripts + 1] = { kind = ch.class, name = ch.props.Name or ch.class,
					source = ch.source or "", parent = myPath }
			else
				copy.children[#copy.children + 1] = clean(ch, myPath)
			end
		end
		return copy
	end
	for _, nd in ipairs(nodes) do
		local c = CLASSES[nd.class]
		if c and c.proxy then
			scripts[#scripts + 1] = { kind = nd.class, name = nd.props.Name or nd.class,
				source = nd.source or "", parent = "Gui" }
		else
			out[#out + 1] = (emit(clean(nd, "Gui"), 0):gsub("^%s+", "")) .. ".Parent = Gui"
			out[#out + 1] = ""
		end
	end
	if #scripts > 0 then
		out[#out + 1] = "-- ===== Scripts you made in the builder. Copy each one into a real script in your game. ====="
		for _, sc in ipairs(scripts) do
			out[#out + 1] = string.format("-- %s %q  (put it inside: %s)", sc.kind, sc.name, sc.parent)
			out[#out + 1] = "--[===["
			out[#out + 1] = sc.source
			out[#out + 1] = "]===]"
			out[#out + 1] = ""
		end
	end
	return table.concat(out, "\n")
end

