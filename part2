    -- ---------- chat commands ----------
    local lastMsg, lastAt = "", 0
    local function handleChat(msg)
        if type(msg) ~= "string" then return end
        local p = state.prefix
        if msg:sub(1, #p) ~= p then return end
        if msg == lastMsg and os.clock() - lastAt < 0.6 then return end   -- both chat systems fired
        local body = msg:sub(#p + 1)
        local name = (body:match("^%s*(%S+)") or ""):lower()
        local entry = LOOKUP[name]
        if not entry then return end                    -- normal chat, ignore quietly
        if not state.chatOn and entry.name ~= "cmds" then return end
        lastMsg, lastAt = msg, os.clock()
        logLine("[chat] " .. msg, "input")
        local status, out = runCommand(msg)
        if out then
            logLine(out, status == true and "ok" or "err")
            showToast("Command", ascii(out), status == true and "success" or "error")
        end
    end

