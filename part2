            nameL.Position = UDim2.new(0, 60, 0, 9)
            nameL.Size = UDim2.new(1, -170, 0, 16)
            nameL.ZIndex = 44
            if not name then
                task.spawn(function()
                    local ok, n = pcall(function() return Players:GetNameFromUserIdAsync(e.uid) end)
                    if ok and n then
                        nameCache[e.uid] = n
                        if nameL.Parent then nameL.Text = ascii(n) end
                    end
                end)
            end

            local parts = {}
            if e.rank then parts[#parts + 1] = Shared.RANK_NAMES[e.rank] end
            if e.premium then parts[#parts + 1] = "Premium" end
            local subL = lbl(row, table.concat(parts, "  |  "), 10, TextMid, Enum.Font.Gotham)
            subL.Position = UDim2.new(0, 60, 0, 29)
            subL.Size = UDim2.new(1, -170, 0, 14)
            subL.ZIndex = 44

            local tagL = lbl(row, TAG_TEXT[e.tag], 10, TAG_COLOR[e.tag], Enum.Font.GothamBold,
                Enum.TextXAlignment.Right)
            tagL.AnchorPoint = Vector2.new(1, 0)
            tagL.Position = UDim2.new(1, -12, 0, 10)
            tagL.Size = UDim2.new(0, 100, 0, 14)
            tagL.ZIndex = 44

            local noteL = lbl(row, TAG_NOTE[e.tag], 9, TextLo, Enum.Font.Gotham, Enum.TextXAlignment.Right)
            noteL.AnchorPoint = Vector2.new(1, 0)
            noteL.Position = UDim2.new(1, -12, 0, 29)
            noteL.Size = UDim2.new(0, 100, 0, 14)
            noteL.ZIndex = 44
            if e.expires then
                rankTimers[#rankTimers + 1] = { label = noteL, expires = e.expires }
                noteL.Text = fmtDuration(math.max(0, e.expires - os.clock())) .. " left"
            end
        end

        local groups = {}
