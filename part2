            speedBox.Text = cleaned
        end
    end)


    local function handleKeyAction(actionName, inputState, inputObject)
        if not fc.active then return Enum.ContextActionResult.Pass end
        if inputObject and inputObject.KeyCode then
            local keyName = interceptedKeyCodes[inputObject.KeyCode]
            if keyName then
                fc.keysDown[keyName] = (inputState == Enum.UserInputState.Begin)
            end
        end
        return Enum.ContextActionResult.Sink
    end

    local function startFreecam()
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or not root then return false end
        camera = workspace.CurrentCamera
        pcall(function() hum:UnequipTools() end)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)
        fc.fallingAfterTeleport = false
        fc.originalAnchored = root.Anchored
        fc.frozenCFrame = root.CFrame
        root.Anchored = true
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if fc.controls then pcall(function() fc.controls:Disable() end) end
        local touchGui = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild("TouchGui")
        if touchGui then touchGui.Enabled = false end
        ContextActionService:BindActionAtPriority(
            "AP_VisualFreecamSink", handleKeyAction, false, 2000000,
            Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D,
            Enum.KeyCode.E, Enum.KeyCode.Q, Enum.KeyCode.Space,
            Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift,
            Enum.PlayerActions.CharacterForward, Enum.PlayerActions.CharacterBackward,
            Enum.PlayerActions.CharacterLeft, Enum.PlayerActions.CharacterRight,
            Enum.PlayerActions.CharacterJump
        )
        local currentCF = camera.CFrame
        fc.camPos = currentCF.Position
        local x, y = currentCF:ToOrientation()
        fc.camPitch, fc.camYaw = math.deg(x), math.deg(y)
        camera.CameraType = Enum.CameraType.Scriptable
        if fc.renderConnection then fc.renderConnection:Disconnect() end
        fc.renderConnection = RunService.RenderStepped:Connect(function(dt)
            camera = workspace.CurrentCamera
            char = LP.Character
            root = char and char:FindFirstChild("HumanoidRootPart")
            if char and root then
                if fc.fallingAfterTeleport then
                    local elapsed = tick() - fc.teleportFallStartTime
                    local vel = root.AssemblyLinearVelocity
                    local groundParams = RaycastParams.new()
                    groundParams.FilterType = Enum.RaycastFilterType.Exclude
                    groundParams.FilterDescendantsInstances = { char }
                    local castDist = (root.Size.Y / 2) + 0.35
                    local groundHit = workspace:Raycast(root.Position, Vector3.new(0, -castDist, 0), groundParams)
                    if elapsed > 0.15 and ((groundHit and math.abs(vel.Y) < 1.5) or elapsed > 8) then
                        fc.fallingAfterTeleport = false
                        root.Anchored = true
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                        fc.frozenCFrame = root.CFrame
                    end
                else
                    root.CFrame = fc.frozenCFrame
                    root.Anchored = true
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end
            end
            local rotCFrame = CFrame.Angles(0, math.rad(fc.camYaw), 0) * CFrame.Angles(math.rad(fc.camPitch), 0, 0)
            local moveVector = Vector3.zero
            if fc.joystickVector.Magnitude > 0.05 then
                moveVector = moveVector + rotCFrame.RightVector * fc.joystickVector.X + rotCFrame.LookVector * fc.joystickVector.Y
            end
            local kbF, kbR, kbU = 0, 0, 0
            if fc.keysDown.W then kbF = kbF + 1 end
            if fc.keysDown.S then kbF = kbF - 1 end
            if fc.keysDown.D then kbR = kbR + 1 end
            if fc.keysDown.A then kbR = kbR - 1 end
            if fc.keysDown.E then kbU = kbU + 1 end
            if fc.keysDown.Q then kbU = kbU - 1 end
            if kbF ~= 0 or kbR ~= 0 or kbU ~= 0 then
                moveVector = moveVector + rotCFrame.LookVector * kbF + rotCFrame.RightVector * kbR + Vector3.new(0, 1, 0) * kbU
            end
            if moveVector.Magnitude > 0 then
                local mult = fc.keysDown.LeftShift and 2 or 1
                fc.camPos = fc.camPos + moveVector.Unit * (fc.flySpeed * mult * dt)
            end
            camera.CFrame = CFrame.new(fc.camPos) * rotCFrame
        end)
        return true
    end

    local function stopFreecam()
        if fc.renderConnection then fc.renderConnection:Disconnect(); fc.renderConnection = nil end
        pcall(function() ContextActionService:UnbindAction("AP_VisualFreecamSink") end)
        pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true) end)
        fc.moveTouchId, fc.lookTouchId = nil, nil
        fc.joystickVector = Vector2.zero
        joystickFrame.Visible = false
        if fc.controls then pcall(function() fc.controls:Enable() end) end
        local touchGui = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild("TouchGui")
        if touchGui then touchGui.Enabled = true end
        for k in pairs(fc.keysDown) do fc.keysDown[k] = false end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if hum then workspace.CurrentCamera.CameraSubject = hum end
        if root then
            root.Anchored = fc.originalAnchored
            if not fc.fallingAfterTeleport then
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end
        end
        fc.fallingAfterTeleport = false
        workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
    end

    local function setFreecam(on)
        if on == fc.active then return end
        if on then
            if not startFreecam() then
                if showToast then showToast("Freecam", "No character", "error") end
                return
            end
            fc.active = true
            toggleBtn.Text = "Freecam: ON"
            statusLbl.Text = "Status: ON  •  WASD move  Q/E up/down  RMB look"
            statusLbl.TextColor3 = Accent
            TweenService:Create(toggleBtn, TweenInfo.new(0.2), { BackgroundColor3 = Accent, TextColor3 = Color3.fromRGB(10, 20, 22) }):Play()
            local sc = toggleBtn:FindFirstChildOfClass("UIScale")
            if sc then
                sc.Scale = 0.9
                TweenService:Create(sc, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
            end
        else
            fc.active = false
            stopFreecam()
            toggleBtn.Text = "Freecam: OFF"
            statusLbl.Text = "Status: OFF"
            statusLbl.TextColor3 = TextMid
            TweenService:Create(toggleBtn, TweenInfo.new(0.2), { BackgroundColor3 = Panel, TextColor3 = TextHi }):Play()
        end
    end

    toggleBtn.MouseButton1Click:Connect(function() setFreecam(not fc.active) end)


    -- Mobile look / move while freecam
    table.insert(fc.conns, UserInputService.InputBegan:Connect(function(input, gp)
        if not fc.active then return end
        if input.UserInputType == Enum.UserInputType.Touch and not gp then
            local vp = workspace.CurrentCamera.ViewportSize
            local touchPos = Vector2.new(input.Position.X, input.Position.Y)
            if touchPos.X < vp.X * 0.48 and not fc.moveTouchId then
                fc.moveTouchId = input
                fc.joystickCenter = touchPos
                joystickFrame.Position = UDim2.new(0, touchPos.X, 0, touchPos.Y)
                joystickKnob.Position = UDim2.new(0.5, 0, 0.5, 0)
                fc.joystickVector = Vector2.zero
                joystickFrame.Visible = true
            elseif touchPos.X >= vp.X * 0.48 and not fc.lookTouchId then
                fc.lookTouchId = input
            end
        end
    end))
    table.insert(fc.conns, UserInputService.InputChanged:Connect(function(input)
        if not fc.active then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            if input == fc.moveTouchId then
                local currentPos = Vector2.new(input.Position.X, input.Position.Y)
                local delta = currentPos - fc.joystickCenter
                if delta.Magnitude > fc.joystickMaxRadius then delta = delta.Unit * fc.joystickMaxRadius end
                joystickKnob.Position = UDim2.new(0.5, delta.X, 0.5, delta.Y)
                fc.joystickVector = Vector2.new(delta.X / fc.joystickMaxRadius, -delta.Y / fc.joystickMaxRadius)
            elseif input == fc.lookTouchId then
                local d = input.Delta
                fc.camYaw = fc.camYaw - (d.X * fc.touchSensitivity)
                fc.camPitch = math.clamp(fc.camPitch - (d.Y * fc.touchSensitivity), -89, 89)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseMovement then
            if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
                local d = input.Delta
                fc.camYaw = fc.camYaw - (d.X * fc.mouseSensitivity)
                fc.camPitch = math.clamp(fc.camPitch - (d.Y * fc.mouseSensitivity), -89, 89)
            end
        end
    end))
    table.insert(fc.conns, UserInputService.InputEnded:Connect(function(input)
        if input == fc.moveTouchId then
            fc.moveTouchId = nil
            fc.joystickVector = Vector2.zero
            joystickFrame.Visible = false
        elseif input == fc.lookTouchId then
            fc.lookTouchId = nil
        end
    end))

    Shared.setFreecam = setFreecam
end

