    pcall(function()
        local TextChatService = game:GetService("TextChatService")
        conns[#conns + 1] = TextChatService.MessageReceived:Connect(function(message)
            local src = message.TextSource
            if src and src.UserId == LP.UserId then handleChat(message.Text) end
        end)
    end)

