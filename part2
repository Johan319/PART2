    local function applySpeedFromBox()
        local n = tonumber(speedBox.Text)
        if not n then
            speedBox.Text = tostring(fc.flySpeed)
            return
        end
        fc.flySpeed = math.clamp(math.floor(n + 0.5), fc.minSpeed, fc.maxSpeed)
        speedBox.Text = tostring(fc.flySpeed)
    end
