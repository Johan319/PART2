local function D(name, kind, enum) return { name = name, kind = kind, enum = enum } end
local function cat(...)
	local out = {}
	for _, t in ipairs({ ... }) do
		for _, d in ipairs(t) do out[#out + 1] = d end
	end
	return out
end

