	out.TextYAlignment = Enum.TextYAlignment.Top
	out.Text = ""
	out.Visible = false
	out.ZIndex = 50
	out.Parent = playGui
	corner(out, 6)

	local function log(text)
		outLines[#outLines + 1] = tostring(text):gsub("[^ -~]", "?")
		while #outLines > 6 do table.remove(outLines, 1) end
		out.Text = table.concat(outLines, "\n")
		out.Visible = true
	end

	local function printer(...)
		local t = {}
		for i = 1, select("#", ...) do t[i] = tostring((select(i, ...))) end
		log(table.concat(t, " "))
	end

	local requireProxy
	local function prepare(fn, inst)
		if setfenv and baseEnv then
			pcall(setfenv, fn, setmetatable({ script = inst, print = printer, warn = printer, require = requireProxy },
				{ __index = baseEnv, __newindex = baseEnv }))
		end
	end

	function requireProxy(m)
		if typeof(m) == "Instance" and m:IsA("StringValue") and m:GetAttribute("BClass") == "ModuleScript" then
			if moduleCache[m] then return moduleCache[m][1] end
			local fn, err = loadstring(m.Value, "=" .. m.Name)
			if not fn then error("Syntax error in " .. m.Name .. ": " .. tostring(err), 2) end
			prepare(fn, m)
			local ok, result = pcall(fn)
			if not ok then error(result, 2) end
			moduleCache[m] = { result }
			return result
		end
		return realRequire(m)
	end

	local function runProxy(inst)
		if not loadstring then
			log("Your executor has no loadstring, so scripts cannot run.")
			return
		end
		local fn, err = loadstring(inst.Value, "=" .. inst.Name)
		if not fn then
			log("Syntax error in " .. inst.Name .. ": " .. tostring(err))
			return
		end
		prepare(fn, inst)
		threads[#threads + 1] = task.spawn(function()
			local ok, e = pcall(fn)
			if not ok then log("Error in " .. inst.Name .. ": " .. tostring(e)) end
		end)
	end

	function setRun(on)
		if on then
			runSnapshot = serializeChildren(projectGui)
			toolGui.Enabled = false
			stageGui.Enabled = false
			playGui.Enabled = true
			clearGuides()
			action = nil
			outLines = {}
			out.Text = ""
			out.Visible = false
			for _, d in ipairs(projectGui:GetDescendants()) do
				if d:IsA("StringValue") then
					local k = d:GetAttribute("BClass")
					if k == "LocalScript" or k == "Script" then runProxy(d) end
				end
			end
		else
			for _, th in ipairs(threads) do pcall(task.cancel, th) end
			threads = {}
			moduleCache = {}
			playGui.Enabled = false
			-- put your GUI back exactly as it was before the test
			if runSnapshot then
				for _, ch in ipairs(projectGui:GetChildren()) do ch:Destroy() end
				buildCount = 0
				for _, n in ipairs(runSnapshot) do buildNode(n, projectGui, 1) end
				runSnapshot = nil
			end
			toolGui.Enabled = true
			stageGui.Enabled = true
			selectInstance(nil)
		end
	end
	runButton.MouseButton1Click:Connect(function() setRun(true) end)
	stop.MouseButton1Click:Connect(function() setRun(false) end)
end

