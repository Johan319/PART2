-- ===================== TAB SWITCHING =====================
local tabTweens = {}
local function cancelPageTweens(page)
    if tabTweens[page] then
        for _, tw in ipairs(tabTweens[page]) do tw:Cancel() end
        tabTweens[page] = nil
    end
end
local function trackTween(page, tw)
    tabTweens[page] = tabTweens[page] or {}
    table.insert(tabTweens[page], tw)
end

local function hideOtherPages(keepA, keepB)
    for _, page in pairs(Pages) do
        if page and page.Parent and page ~= keepA and page ~= keepB then
            cancelPageTweens(page)
            page.Visible = false
            page.Position = UDim2.new(0, 0, 0, 0)
        end
    end
end

local function fadeOutPage(page, cb)
    if not page then
        if cb then cb() end
        return
    end
    cancelPageTweens(page)
    local slide = TweenService:Create(page,
        TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        { Position = UDim2.new(0, -14, 0, 0) })
    trackTween(page, slide)
    slide.Completed:Connect(function()
        page.Visible = false
        page.Position = UDim2.new(0, 14, 0, 0)
        if cb then cb() end
    end)
    slide:Play()
end

local function fadeInPage(page)
    if not page then return end
    cancelPageTweens(page)
    page.Position = UDim2.new(0, 14, 0, 0)
    page.Visible = true
    local slide = TweenService:Create(page,
        TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
        { Position = UDim2.new(0, 0, 0, 0) })
    trackTween(page, slide)
    slide:Play()
end

