            av.ZIndex = 44
            corner(av, 0).CornerRadius = UDim.new(0.5, 0)
            stroke(av, TAG_COLOR[e.tag], 1.5, 0.2)

            local pl = Players:GetPlayerByUserId(e.uid or 0)
