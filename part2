    local function collectRanks()
        local entries = {}
        local function add(uid, name, rank, premium, tag, expires)
            entries[#entries + 1] = {
                uid = uid, name = name, rank = rank, premium = premium, tag = tag, expires = expires,
            }
        end
        -- (auto): the rank you get from DEFAULT_RANK / RANK_IDS at the top of the script
        add(LP.UserId, LP.Name, Shared.baseRank, Shared.basePremium, "auto")
        for rk, rankLabel in ipairs(Shared.RANK_NAMES) do
            local list = Shared.RANK_IDS[rankLabel]
            if list then
                for _, id in ipairs(list) do
                    if id ~= LP.UserId then add(id, nil, rk, false, "auto") end
                end
            end
        end
        for _, id in ipairs(Shared.PREMIUM_IDS) do
            if id ~= LP.UserId then add(id, nil, nil, true, "auto") end
        end
        for key, g in pairs(grants.session) do add(tonumber(key), g.name, g.rank, g.premium, "rank") end
        for key, g in pairs(grants.perm) do add(tonumber(key), g.name, g.rank, g.premium, "permrank") end
        for key, g in pairs(grants.temp) do add(tonumber(key), g.name, g.rank, g.premium, "temprank", g.expires) end
        return entries
    end

    local function renderRanks()
        for _, c in ipairs(RList:GetChildren()) do
            if c:IsA("GuiObject") then c:Destroy() end
        end
        rankTimers = {}

        local order, pops = 0, 0
        local function nextOrder()
            order += 1
            return order
        end

        local function header(text)
            local h = lbl(RList, "------" .. text .. "------", 11, Accent, Enum.Font.Code,
                Enum.TextXAlignment.Center)
