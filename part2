-- tap an element on the screen to select it
local function overTool(pos)
	for name, w in pairs(windows) do
		if w.Visible ~= false then
			local ap, as = w.AbsolutePosition, w.AbsoluteSize
			if pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then return true end
		end
	end
	if selected and selected:IsA("GuiObject") then
		local ap, as = selected.AbsolutePosition, selected.AbsoluteSize
		if pos.X >= ap.X - 14 and pos.X <= ap.X + as.X + 14 and pos.Y >= ap.Y - 14 and pos.Y <= ap.Y + as.Y + 14 then
			return true
		end
	end
	return false
end

UserInputService.InputBegan:Connect(function(input)
	if not toolGui.Enabled or action then return end
	local isMouse = input.UserInputType == Enum.UserInputType.MouseButton1
	if not isMouse and input.UserInputType ~= Enum.UserInputType.Touch then return end
	local pos
	if isMouse then
		pos = UserInputService:GetMouseLocation()
	else
		local inset = GuiService:GetGuiInset()
		pos = Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
	end
	if overTool(pos) then return end
	local best, bestZ = nil, -1
	for _, d in ipairs(projectGui:GetDescendants()) do
		if d:IsA("GuiObject") and d.Visible and not d.Name:match("^__") then
			local ap, as = d.AbsolutePosition, d.AbsoluteSize
			if as.X > 2 and as.Y > 2 and pos.X >= ap.X and pos.X <= ap.X + as.X and pos.Y >= ap.Y and pos.Y <= ap.Y + as.Y then
				if d.ZIndex >= bestZ then best, bestZ = d, d.ZIndex end
			end
		end
	end
	if best and best:IsA("GuiObject") then
		-- select then drag in the same click (Studio-style)
		if best ~= selected then
			selectInstance(best)
		end
		beginAction("move", input)
	else
		selectInstance(nil)
	end
end)

-- ================= EXPLORER LOGIC =================
local explorerRows = {}

local function container()
	if selected and selected.Parent then
		if selected:IsA("GuiObject") then return selected end
		return selected.Parent
	end
	return projectGui
end

local addTarget = nil -- parent to insert into when picking from Add list

function refreshExplorer()
	for _, r in ipairs(explorerRows) do r:Destroy() end
	explorerRows = {}
	local order = 0
	local function row(inst, depth)
		order += 1
		local isRoot = (inst == projectGui)
		local canHold = isRoot or inst:IsA("GuiObject") or inst:IsA("Folder")
		local b = Instance.new("Frame")
		b.LayoutOrder = order
		b.Size = UDim2.new(1, -6, 0, 26)
		b.BackgroundColor3 = (inst == selected) and Color3.fromRGB(28, 56, 76) or PANEL
		b.BorderSizePixel = 0
		b.ZIndex = 23
		b.Parent = explorerList
		corner(b, 5)

		local pick = Instance.new("TextButton")
		pick.BackgroundTransparency = 1
		pick.Position = UDim2.new(0, 0, 0, 0)
		pick.Size = UDim2.new(1, canHold and -28 or -4, 1, 0)
		pick.Font = Enum.Font.Gotham
		pick.TextSize = 12
		pick.TextXAlignment = Enum.TextXAlignment.Left
		pick.TextColor3 = (inst == selected) and ACCENT or TEXT
		pick.TextTruncate = Enum.TextTruncate.AtEnd
		pick.Text = "  " .. string.rep("  ", depth) .. (isRoot and ("Gui: " .. CONFIG.ProjectGuiName) or (keyOf(inst) .. '  "' .. inst.Name .. '"'))
		pick.AutoButtonColor = false
		pick.ZIndex = 24
		pick.Parent = b
		pick.MouseButton1Click:Connect(function() selectInstance(isRoot and nil or inst) end)

		-- + stays on the RIGHT of the row (never jumps to the bottom bar)
		if canHold then
			local plus = Instance.new("TextButton")
			plus.AnchorPoint = Vector2.new(1, 0.5)
			plus.Position = UDim2.new(1, -4, 0.5, 0)
			plus.Size = UDim2.fromOffset(22, 20)
			plus.BackgroundColor3 = ACCENT
			plus.BorderSizePixel = 0
			plus.Font = Enum.Font.GothamBold
			plus.Text = "+"
			plus.TextSize = 14
			plus.TextColor3 = Color3.fromRGB(0, 20, 30)
			plus.AutoButtonColor = false
			plus.ZIndex = 25
			plus.Parent = b
			corner(plus, 5)
			plus.MouseButton1Click:Connect(function()
				addTarget = isRoot and projectGui or inst
				selectInstance(isRoot and nil or inst)
				if addWin then addWin.Visible = true end
			end)
		end

		explorerRows[#explorerRows + 1] = b
		for _, ch in ipairs(inst:GetChildren()) do
			if CLASSES[keyOf(ch)] then row(ch, depth + 1) end
		end
	end
	row(projectGui, 0)
end

function selectInstance(inst)
	selected = inst
	if refreshProperties then refreshProperties() end
	refreshExplorer()
end

local function deleteSelected()
	local inst = selected
	if not inst or not inst.Parent then
		showToast("Explorer", "Select a Frame (or element) in Explorer first", "info")
		return
	end
	if inst == projectGui then
		showToast("Explorer", "Cannot delete the root Gui", "error")
		return
	end
	-- only delete GuiObjects from the project (Frames, labels, buttons, etc.)
	if not inst:IsA("GuiObject") and not inst:IsA("UIComponent") and not inst:IsA("Folder") then
		showToast("Explorer", "Can only delete GUI elements", "info")
		return
	end
	local par = inst.Parent
	local nm = inst.Name
	if clearBuilderAnimation then pcall(clearBuilderAnimation, inst) end
	-- clear selection before destroy so UI does not hold a dead ref
	selected = nil
	pcall(function() inst:Destroy() end)
	if refreshExplorer then refreshExplorer() end
	if refreshProperties then refreshProperties() end
	if par and par.Parent and par ~= projectGui and par:IsA("GuiObject") then
		selectInstance(par)
	else
		selectInstance(nil)
	end
	showToast("Explorer", "Deleted " .. tostring(nm), "success")
end
