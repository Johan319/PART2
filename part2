-- ================= SAVE / LOAD (files on your device) =================
local saveWin, saveBody = makeWindow("SaveLoad", "Save / Load", 300, 340, UDim2.new(0.5, -150, 0.5, -170))
local saveStatus
local autosaveNow, autoloadOnce
do
	local DIR = "AdminPanel_Builder"
	local hasFS = (writefile ~= nil and readfile ~= nil and isfile ~= nil
		and makefolder ~= nil and isfolder ~= nil and listfiles ~= nil)
	local session = {}   -- used when your executor cannot write files

	local function fileFor(name) return DIR .. "/" .. name .. ".json" end

	local function storeWrite(name, json)
		session[name] = json
		if hasFS then
			pcall(function()
				if not isfolder(DIR) then makefolder(DIR) end
				writefile(fileFor(name), json)
			end)
		end
	end

	local function storeRead(name)
		if hasFS then
			local ok, r = pcall(function()
				if isfile(fileFor(name)) then return readfile(fileFor(name)) end
			end)
			if ok and type(r) == "string" then return r end
		end
		return session[name]
	end

	local function storeDelete(name)
		session[name] = nil
		if hasFS then
			pcall(function()
				if delfile and isfile(fileFor(name)) then delfile(fileFor(name)) end
			end)
		end
	end

	local function storeList()
		local names, seen = {}, {}
		local function add(n)
			if n and not seen[n] and n:sub(1, 1) ~= "_" then
				seen[n] = true
				names[#names + 1] = n
			end
		end
		for n in pairs(session) do add(n) end
		if hasFS then
			pcall(function()
				if isfolder(DIR) then
					for _, path in ipairs(listfiles(DIR)) do
						local f = tostring(path):match("([^/\\]+)$") or ""
						add(f:match("^(.+)%.json$"))
					end
				end
			end)
		end
		table.sort(names)
		return names
	end

	local function snapshotJson()
		return HttpService:JSONEncode(serializeChildren(projectGui))
	end

	local function loadJson(json)
		local ok, nodes = pcall(function() return HttpService:JSONDecode(json) end)
		if not ok or type(nodes) ~= "table" then return false end
		selectInstance(nil)
		for _, ch in ipairs(projectGui:GetChildren()) do
			if CLASSES[keyOf(ch)] then ch:Destroy() end
		end
		buildCount = 0
		for _, n in ipairs(nodes) do buildNode(n, projectGui, 1) end
		refreshExplorer()
		return true
	end

	function autosaveNow()
		if #projectGui:GetChildren() > 0 then
			storeWrite("_autosave", snapshotJson())
			storeWrite("_server_" .. tostring(currentBuilderServer):gsub("[^%w_%- ]", ""), snapshotJson())
		end
	end

	local restored = false
	function autoloadOnce()
		if restored then return end
		restored = true
		local safeName = tostring(currentBuilderServer):gsub("[^%w_%- ]", "")
		local json = storeRead("_server_" .. safeName) or storeRead("_autosave")
		if json then loadJson(json) end
	end

	local nameBox, nameInput = textBox(saveBody, "Save name")
	nameBox.Position = UDim2.new(0, 8, 0, 8)
	nameBox.Size = UDim2.new(1, -108, 0, 30)
	local saveNew = button(saveBody, "Save", GREEN, Color3.fromRGB(8, 28, 16))
	saveNew.AnchorPoint = Vector2.new(1, 0)
	saveNew.Position = UDim2.new(1, -8, 0, 8)
	saveNew.Size = UDim2.fromOffset(92, 30)
	local list = scroller(saveBody)
	list.Position = UDim2.new(0, 8, 0, 46)
	list.Size = UDim2.new(1, -16, 1, -74)
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	saveStatus = label(saveBody, "", 11, SUB, Enum.Font.Gotham)
	saveStatus.AnchorPoint = Vector2.new(0, 1)
	saveStatus.Position = UDim2.new(0, 10, 1, -6)
	saveStatus.Size = UDim2.new(1, -20, 0, 16)

	local renderSaves
	function renderSaves()
		for _, c in ipairs(list:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		local names = storeList()
		for i, n in ipairs(names) do
			local row = Instance.new("Frame")
			row.LayoutOrder = i
			row.Size = UDim2.new(1, -6, 0, 34)
			row.BackgroundColor3 = PANEL
			row.BorderSizePixel = 0
			row.ZIndex = 22
			row.Parent = list
			corner(row, 6)
			local t = label(row, n, 12, TEXT, Enum.Font.Gotham)
			t.Position = UDim2.new(0, 8, 0, 0)
			t.Size = UDim2.new(1, -150, 1, 0)
			local function mini(text, x, color)
				local b = button(row, text, PANEL2, color)
				b.AnchorPoint = Vector2.new(1, 0.5)
				b.Position = UDim2.new(1, x, 0.5, 0)
				b.Size = UDim2.fromOffset(42, 24)
				b.TextSize = 10
				return b
			end
			mini("Load", -92, GREEN).MouseButton1Click:Connect(function()
				local json = storeRead(n)
				saveStatus.Text = (json and loadJson(json)) and ("Loaded: " .. n) or "Could not load that save"
			end)
			mini("Update", -48, ACCENT).MouseButton1Click:Connect(function()
				storeWrite(n, snapshotJson())
				saveStatus.Text = "Updated: " .. n
			end)
			mini("X", -4, RED).MouseButton1Click:Connect(function()
				storeDelete(n)
				saveStatus.Text = "Deleted: " .. n
				renderSaves()
			end)
		end
		if #names == 0 then saveStatus.Text = "No saves yet" end
	end

	saveNew.MouseButton1Click:Connect(function()
		local name = (nameInput.Text:gsub("[^%w_%- ]", "")):gsub("^%s+", ""):gsub("%s+$", "")
		name = name:sub(1, 24)
		if name == "" or name:sub(1, 1) == "_" then
			saveStatus.Text = "Type a name first (it cannot start with _)"
			return
		end
		storeWrite(name, snapshotJson())
		nameInput.Text = ""
		saveStatus.Text = "Saved: " .. name
		renderSaves()
	end)
	saveWin:GetPropertyChangedSignal("Visible"):Connect(function()
		if saveWin.Visible then renderSaves() end
	end)

	-- ================= BUILDER SERVERS =================
	local serverNames = {}
	local serverNameBox, serverNameInput
	local renameTarget = nil
	local serverStatus
	local serverList
	local serverLayout

	local function cleanServerName(raw)
		raw = tostring(raw or "")
		raw = raw:gsub("[^%w_%- ]", ""):gsub("%s+", " "):gsub("^%s+", ""):gsub("%s+$", "")
		return raw:sub(1, 28)
	end

	local function serverKey(name)
		return "_server_" .. cleanServerName(name)
	end

	local function saveServerIndex()
		storeWrite("_server_index", HttpService:JSONEncode(serverNames))
	end

	local function loadServerIndex()
		serverNames = {}
		local raw = storeRead("_server_index")
		if raw then
			local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
			if ok and type(data) == "table" then
				for _, n in ipairs(data) do
					local clean = cleanServerName(n)
					if clean ~= "" and not table.find(serverNames, clean) then serverNames[#serverNames + 1] = clean end
				end
			end
		end
		if #serverNames == 0 then serverNames = { "Main Server" } end
		if not table.find(serverNames, "Main Server") then table.insert(serverNames, 1, "Main Server") end
		table.sort(serverNames, function(a, b)
			if a == "Main Server" then return true end
			if b == "Main Server" then return false end
			return a:lower() < b:lower()
		end)
	saveServerIndex()
	end

	local function saveCurrentServer()
		storeWrite(serverKey(currentBuilderServer), snapshotJson())
		storeWrite("_autosave", snapshotJson())
	end

	local function loadServer(name)
		local json = storeRead(serverKey(name))
		if json then
			return loadJson(json)
		end
		selectInstance(nil)
		for _, ch in ipairs(projectGui:GetChildren()) do
			if CLASSES[keyOf(ch)] then
				clearBuilderAnimation(ch)
				ch:Destroy()
			end
		end
		return true
	end

	initializeBuilderServers = function()
		loadServerIndex()
		local existing = storeRead(serverKey(currentBuilderServer))
		if existing then
			loadJson(existing)
		elseif currentBuilderServer == "Main Server" then
			local legacy = storeRead("_autosave")
			if legacy and loadJson(legacy) then storeWrite(serverKey(currentBuilderServer), legacy) end
		end
		if updateServerPill then updateServerPill(currentBuilderServer) end
	end

	switchBuilderServer = function(name)
		name = cleanServerName(name)
		if name == "" or not table.find(serverNames, name) then return false end
		if name == currentBuilderServer then return true end
		saveCurrentServer()
		currentBuilderServer = name
		local ok = loadServer(name)
		if not ok then return false end
		if updateServerPill then updateServerPill(currentBuilderServer) end
		if refreshExplorer then refreshExplorer() end
		if refreshProperties then refreshProperties() end
		return true
	end

	createBuilderServer = function(rawName)
		local name = cleanServerName(rawName)
		if name == "" then return false, "Type a server name first." end
		if table.find(serverNames, name) then return false, "That server already exists." end
		saveCurrentServer()
		serverNames[#serverNames + 1] = name
		saveServerIndex()
		storeWrite(serverKey(name), HttpService:JSONEncode({}))
		currentBuilderServer = name
		loadServer(name)
		if updateServerPill then updateServerPill(name) end
		if refreshExplorer then refreshExplorer() end
		if refreshProperties then refreshProperties() end
		return true
	end

	renameBuilderServer = function(oldName, newRaw)
		local newName = cleanServerName(newRaw)
		if newName == "" then return false, "Type a server name first." end
		if not table.find(serverNames, oldName) then return false, "Server no longer exists." end
		if newName ~= oldName and table.find(serverNames, newName) then return false, "That server name is already used." end
		local json = storeRead(serverKey(oldName)) or HttpService:JSONEncode({})
		storeWrite(serverKey(newName), json)
		if newName ~= oldName then storeDelete(serverKey(oldName)) end
		for i, n in ipairs(serverNames) do
			if n == oldName then serverNames[i] = newName break end
		end
		saveServerIndex()
		if currentBuilderServer == oldName then currentBuilderServer = newName end
		if updateServerPill then updateServerPill(currentBuilderServer) end
		return true
	end

	local function deleteBuilderServer(name)
		name = tostring(name or "")
		if name == "" then return false, "No server selected." end
		if name == "Main Server" then return false, "Cannot delete Main Server." end
		if not table.find(serverNames, name) then return false, "Server not found." end
		-- if deleting the active one, switch to Main first
		if currentBuilderServer == name then
			switchBuilderServer("Main Server")
		end
		storeDelete(serverKey(name))
		for i = #serverNames, 1, -1 do
			if serverNames[i] == name then table.remove(serverNames, i) end
		end
		saveServerIndex()
		if updateServerPill then updateServerPill(currentBuilderServer) end
		return true
	end

	local function renderServerList()
		for _, c in ipairs(serverList:GetChildren()) do
			if c:IsA("Frame") then c:Destroy() end
		end
		for i, name in ipairs(serverNames) do
			local row = Instance.new("Frame")
			row.Name = "Server_" .. name
			row.LayoutOrder = i
			row.Size = UDim2.new(1, -4, 0, 54)
			row.BackgroundColor3 = (name == currentBuilderServer) and Color3.fromRGB(20, 36, 46) or PANEL
			row.BorderSizePixel = 0
			row.ZIndex = 22
			row.Parent = serverList
			corner(row, 9)
			stroke(row, name == currentBuilderServer and ACCENT or DIV, 1, 0.45)

			local pick = Instance.new("TextButton")
			pick.BackgroundTransparency = 1
			pick.Position = UDim2.new(0, 0, 0, 0)
			pick.Size = UDim2.new(1, -110, 1, 0)
			pick.Text = ""
			pick.AutoButtonColor = false
			pick.ZIndex = 23
			pick.Parent = row
			pick.MouseButton1Click:Connect(function()
				if switchBuilderServer(name) then
