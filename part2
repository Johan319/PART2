	inBox.Size = UDim2.new(1, -16, 0, 30)
	local modeBtn = button(aiBody, "Mode: Chat", PANEL2, TEXT)
	modeBtn.AnchorPoint = Vector2.new(0, 1)
	modeBtn.Position = UDim2.new(0, 8, 1, -8)
	modeBtn.Size = UDim2.new(0.38, -10, 0, 30)
	local send = button(aiBody, "Send", ACCENT, Color3.fromRGB(0, 20, 30))
