        -- Mods: Anti Skybox / Nuke — strip nuke avatar asset characters locally
        if on then
            local TargetIDs = {
                [115959405843119] = true,
                [115869670697835] = true,
                [100839513065432] = true,
            }
            local list = {}
            local function hasID(v)
                if typeof(v) == "table" then
                    for _, id in ipairs(v) do
                        if TargetIDs[tonumber(id)] then return true end
                    end
                else
                    if TargetIDs[tonumber(v)] then return true end
                end
                return false
            end
            local function detectNuke(desc)
                if not desc then return false end
                if hasID(desc.Head) or hasID(desc.Face) or hasID(desc.Shirt) or hasID(desc.Pants) then
                    return true
                end
                for _, b in ipairs({ "Torso", "RightArm", "LeftArm", "RightLeg", "LeftLeg" }) do
                    if hasID(desc[b]) then return true end
                end
                pcall(function()
                    for _, ac in ipairs(desc:GetAccessories(true)) do
                        if ac.AssetId and TargetIDs[tonumber(ac.AssetId)] then
                            error("nuke")
                        end
                    end
                end)
                local ok = true
                pcall(function()
                    for _, ac in ipairs(desc:GetAccessories(true)) do
                        if ac.AssetId and TargetIDs[tonumber(ac.AssetId)] then
                            ok = false
                        end
                    end
                end)
                if not ok then return true end
                for _, anim in ipairs({
                    "IdleAnimation", "WalkAnimation", "RunAnimation", "JumpAnimation",
                    "ClimbAnimation", "FallAnimation", "SwimAnimation",
                }) do
                    if hasID(desc[anim]) then return true end
                end
                return false
            end
            local function destroyParts(char)
                for _, name in ipairs({
                    "Head", "Torso", "UpperTorso", "LowerTorso",
                    "Left Leg", "Right Leg", "LeftUpperLeg", "RightUpperLeg",
                    "LeftLowerLeg", "RightLowerLeg",
                }) do
                    local part = char:FindFirstChild(name)
                    if part then pcall(function() part:Destroy() end) end
                end
            end
            local function checkNuke(targetPlayer, char)
                if not protOn(key) or targetPlayer == LP or not char then return end
                local hum = char:FindFirstChildOfClass("Humanoid")
                if not hum then return end
                pcall(function()
                    local desc = hum:GetAppliedDescription()
                    if detectNuke(desc) then destroyParts(char) end
                end)
                list[#list + 1] = hum.DescendantAdded:Connect(function()
                    if not protOn(key) then return end
                    pcall(function()
                        local newDesc = hum:GetAppliedDescription()
                        if detectNuke(newDesc) then destroyParts(char) end
                    end)
                end)
            end
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LP then
                    if p.Character then checkNuke(p, p.Character) end
                    list[#list + 1] = p.CharacterAdded:Connect(function(c) checkNuke(p, c) end)
                end
            end
            list[#list + 1] = Players.PlayerAdded:Connect(function(p)
                if p == LP then return end
                list[#list + 1] = p.CharacterAdded:Connect(function(c) checkNuke(p, c) end)
                if p.Character then checkNuke(p, p.Character) end
            end)
            Shared.protections.conns[key] = list
        end
    elseif key == "antiscripters" then
