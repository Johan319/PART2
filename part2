-- Minimized open button: larger, draggable, always on main gui
local function createOpenButton()
    local existing = gui:FindFirstChild("OpenButton")
    if existing then
        existing.Visible = true
        return existing
    end

    local ICON = Color3.fromRGB(230, 232, 236)
    local BG = Color3.fromRGB(22, 24, 28)

    local open = Instance.new("TextButton", gui)
    open.Name = "OpenButton"
    open.BackgroundColor3 = BG
    open.BackgroundTransparency = 0.05
    open.BorderSizePixel = 0
    open.AnchorPoint = Vector2.new(0, 0)
    open.Position = UDim2.new(0, 168, 0, 10)
    open.Size = UDim2.new(0, 44, 0, 44)
    open.Text = ""
    open.AutoButtonColor = false
    open.ZIndex = 200
    open.Active = true
    open.Draggable = true
    open.Visible = true
    corner(open, 22)
    stroke(open, Color3.fromRGB(55, 58, 64), 1.2, 0.3)

    local icon = Instance.new("Frame", open)
    icon.BackgroundTransparency = 1
    icon.AnchorPoint = Vector2.new(0.5, 0.5)
    icon.Position = UDim2.new(0.5, 0, 0.5, 0)
    icon.Size = UDim2.new(0, 22, 0, 22)
    icon.ZIndex = 201
    icon.Active = false

    local function part(parent, px, py, sx, sy, rad, z)
        local f = Instance.new("Frame", parent)
        f.BackgroundColor3 = ICON
        f.BorderSizePixel = 0
        f.Position = UDim2.new(0, px, 0, py)
        f.Size = UDim2.new(0, sx, 0, sy)
        f.ZIndex = z or 202
        f.Active = false
        corner(f, rad or 2)
        return f
    end
    part(icon, 2, 1, 9, 9, 99, 203)
    part(icon, 0, 10, 13, 10, 6, 203)
    local gear = Instance.new("Frame", icon)
    gear.BackgroundTransparency = 1
    gear.Position = UDim2.new(0, 9, 0, 8)
    gear.Size = UDim2.new(0, 13, 0, 13)
    gear.ZIndex = 204
    gear.Active = false
    part(gear, 3, 3, 7, 7, 99, 206)
    local ringG = Instance.new("Frame", gear)
    ringG.BackgroundTransparency = 1
    ringG.Position = UDim2.new(0, 2, 0, 2)
    ringG.Size = UDim2.new(0, 9, 0, 9)
    ringG.ZIndex = 205
    ringG.Active = false
    corner(ringG, 99)
    stroke(ringG, ICON, 1.8, 0)

    open.MouseEnter:Connect(function()
        TweenService:Create(open, TweenInfo.new(0.12), { BackgroundColor3 = Color3.fromRGB(34, 36, 42) }):Play()
    end)
    open.MouseLeave:Connect(function()
        TweenService:Create(open, TweenInfo.new(0.12), { BackgroundColor3 = BG }):Play()
    end)
    open.MouseButton1Click:Connect(function()
        open.Visible = false
        openPanel()
    end)
    return open
end


