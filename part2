    logLine("Chat commands use the prefix " .. state.prefix
        .. " (other players can see chat messages). Console commands stay private.", "info")
    if state.autosave then logLine("Loaded your saved prefix.", "ok") end
    do
        local savedCount = 0
        for _ in pairs(grants.perm) do savedCount += 1 end
        if savedCount > 0 then logLine("Loaded " .. savedCount .. " saved rank(s).", "ok") end
    end

    Shared.makeLock(Page, "Mods only", "Ask a Mod or higher to unlock this tab.",
        function() return Shared.rank < 2 end)

    return Page
end)()

