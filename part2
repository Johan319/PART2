local function animateWindowOpen(w)
	if not w then return end
	local targetSize = w:GetAttribute("_TargetSize")
	if not targetSize then
		targetSize = w.Size
		w:SetAttribute("_TargetSizeX", targetSize.X.Offset)
		w:SetAttribute("_TargetSizeY", targetSize.Y.Offset)
	else
		targetSize = UDim2.fromOffset(w:GetAttribute("_TargetSizeX") or 280, w:GetAttribute("_TargetSizeY") or 200)
	end
	w.Visible = true
	w.BackgroundTransparency = 1
	local sc = w:FindFirstChild("_AnimScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Name = "_AnimScale"
		sc.Parent = w
	end
	sc.Scale = 0.88
	TweenService:Create(w, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 0 }):Play()
	TweenService:Create(sc, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function animateWindowClose(w)
	if not w or not w.Visible then return end
	local sc = w:FindFirstChild("_AnimScale")
	if not sc then
		sc = Instance.new("UIScale")
		sc.Name = "_AnimScale"
		sc.Parent = w
	end
	TweenService:Create(w, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 }):Play()
	local tw = TweenService:Create(sc, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.9 })
	tw.Completed:Connect(function()
		w.Visible = false
		w.BackgroundTransparency = 0
		sc.Scale = 1
	end)
	tw:Play()
end

local function toggleWindow(name)
	local w = windows[name]
	if not w then return end
	if w.Visible then
		animateWindowClose(w)
	else
		animateWindowOpen(w)
	end
end

