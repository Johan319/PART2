local ORDER = { "Frame", "TextLabel", "TextButton", "TextBox", "ImageLabel", "ImageButton", "ScrollingFrame",
	"CanvasGroup", "UICorner", "UIStroke", "UIListLayout", "UIGridLayout", "UIPadding", "UIScale", "UIGradient",
	"UIAspectRatioConstraint", "UISizeConstraint", "UITextSizeConstraint", "UIPageLayout", "UITableLayout",
	"LocalScript", "Script", "ModuleScript", "StringValue", "NumberValue", "IntValue", "BoolValue", "Color3Value",
	"BindableEvent", "Sound", "Folder" }
do
	-- keep only what this Roblox version can create
	local usable = {}
	for _, cn in ipairs(ORDER) do
		local c = CLASSES[cn]
		local ok = c ~= nil
		if ok and not c.proxy then
			ok = pcall(function() Instance.new(cn):Destroy() end)
		end
		if ok then usable[#usable + 1] = cn end
	end
	ORDER = usable
end

-- script items are stored as a StringValue with a marker, so a name tells us what they really are
local function keyOf(inst)
	local k = inst:GetAttribute("BClass")
	if k and CLASSES[k] then return k end
	return inst.ClassName
end

local function c255(x) return math.floor(math.clamp(x, 0, 1) * 255 + 0.5) end
local function rgb(a, b, c) return Color3.fromRGB(math.clamp(a, 0, 255), math.clamp(b, 0, 255), math.clamp(c, 0, 255)) end

local ENC = {
	color = function(v) return { c255(v.R), c255(v.G), c255(v.B) } end,
	udim2 = function(v) return { v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset } end,
	udim = function(v) return { v.Scale, v.Offset } end,
	vector2 = function(v) return { v.X, v.Y } end,
	enum = function(v) return v.Name end,
	gradient = function(v)
		local t = {}
		for _, k in ipairs(v.Keypoints) do
			t[#t + 1] = { k.Time, c255(k.Value.R), c255(k.Value.G), c255(k.Value.B) }
		end
		return t
	end,
}

local DEC = {
	string = function(v) if type(v) == "string" then return v:sub(1, 300) end end,
	bool = function(v) if type(v) == "boolean" then return v end end,
	number = function(v) return num(v) end,
	color = function(v)
		if type(v) == "table" then
			local r, g, b = num(v[1]), num(v[2]), num(v[3])
			if r and g and b then return rgb(r, g, b) end
		end
	end,
	udim2 = function(v)
		if type(v) == "table" then
			local a, b, c, d = num(v[1]), num(v[2]), num(v[3]), num(v[4])
			if a and b and c and d then return UDim2.new(a, b, c, d) end
		end
	end,
	udim = function(v)
		if type(v) == "table" then
			local a, b = num(v[1]), num(v[2])
			if a and b then return UDim.new(a, b) end
		end
	end,
	vector2 = function(v)
		if type(v) == "table" then
			local a, b = num(v[1]), num(v[2])
			if a and b then return Vector2.new(a, b) end
		end
	end,
	enum = function(v, def)
		if type(v) == "string" then
			local ok, item = pcall(function() return def.enum[v] end)
			if ok and item then return item end
		end
	end,
	gradient = function(v)
		if type(v) ~= "table" then return nil end
		local pts = {}
		for _, k in ipairs(v) do
			if type(k) == "table" then
				local t, r, g, b = num(k[1]), num(k[2]), num(k[3]), num(k[4])
				if t and r and g and b then pts[#pts + 1] = { math.clamp(t, 0, 1), rgb(r, g, b) } end
			end
		end
		if #pts < 2 then return nil end
		table.sort(pts, function(a, b) return a[1] < b[1] end)
		pts[1][1] = 0
		local seq, last = {}, -1
		for i, p in ipairs(pts) do
			local t = (i == #pts) and 1 or p[1]
			if t > last then
				seq[#seq + 1] = ColorSequenceKeypoint.new(t, p[2])
				last = t
			end
		end
		if #seq < 2 then return nil end
		local ok, cs = pcall(ColorSequence.new, seq)
		if ok then return cs end
	end,
}

local animationTweens = setmetatable({}, { __mode = "k" })

local function clearBuilderAnimation(inst)
	local rec = animationTweens[inst]
	if rec then
		for _, tw in ipairs(rec.tweens or {}) do pcall(function() tw:Cancel() end) end
		animationTweens[inst] = nil
	end
	local scale = inst:FindFirstChild("__AnimScale")
	if scale then scale:Destroy() end
end

applyBuilderAnimation = function(inst)
	if not (inst and inst:IsA("GuiObject")) then return end
	clearBuilderAnimation(inst)
	local preset = inst:GetAttribute("BAnimation")
	if type(preset) ~= "string" or preset == "" or preset == "None" then return end
	local rec = { tweens = {} }
	animationTweens[inst] = rec
	local infoFloat = TweenInfo.new(1.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local infoPulse = TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
	local infoSpin = TweenInfo.new(1.6, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1, false)

	if preset == "Float" or preset == "Float + Pulse" then
		local p = inst.Position
		rec.tweens[#rec.tweens + 1] = TweenService:Create(inst, infoFloat, {
			Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + 8)
		})
		rec.tweens[#rec.tweens]:Play()
	end
	if preset == "Pulse" or preset == "Float + Pulse" then
		local sc = Instance.new("UIScale")
		sc.Name = "__AnimScale"
		sc.Scale = 1
		sc.Parent = inst
		rec.tweens[#rec.tweens + 1] = TweenService:Create(sc, infoPulse, { Scale = 1.05 })
		rec.tweens[#rec.tweens]:Play()
	end
	if preset == "Spin" then
		rec.tweens[#rec.tweens + 1] = TweenService:Create(inst, infoSpin, { Rotation = inst.Rotation + 360 })
		rec.tweens[#rec.tweens]:Play()
	end
end

local function setAnimation(inst, preset)
	if not (inst and inst:IsA("GuiObject")) then return end
	if preset == "None" then
		inst:SetAttribute("BAnimation", nil)
	else
		inst:SetAttribute("BAnimation", preset)
	end
	applyBuilderAnimation(inst)
end

local function serializeInst(inst, depth)
	local key = keyOf(inst)
	local cls = CLASSES[key]
	if not cls or inst.Name:sub(1, 2) == "__" then return nil end
	local node = { class = key, props = {}, children = {} }
	if cls.proxy then node.source = inst.Value end
	local anim = inst:GetAttribute("BAnimation")
	if type(anim) == "string" and anim ~= "" and anim ~= "None" then node.animate = anim end
	for _, def in ipairs(cls.props) do
		local ok, v = pcall(function() return inst[def.name] end)
		if ok and v ~= nil then
			local enc = ENC[def.kind]
			node.props[def.name] = enc and enc(v) or v
		end
	end
	if depth < 14 then
		for _, ch in ipairs(inst:GetChildren()) do
			local n = serializeInst(ch, depth + 1)
			if n then node.children[#node.children + 1] = n end
		end
	end
	return node
end

local function serializeChildren(root)
	local out = {}
	for _, ch in ipairs(root:GetChildren()) do
		local n = serializeInst(ch, 1)
		if n then out[#out + 1] = n end
	end
	return out
end

local buildCount = 0
local function buildNode(node, parent, depth)
	if type(node) ~= "table" or buildCount >= 400 or depth > 14 then return nil end
	local cls = CLASSES[node.class]
	if not cls then return nil end
	buildCount += 1
	local inst
	if cls.proxy then
		inst = Instance.new("StringValue")
		inst:SetAttribute("BClass", node.class)
		inst.Value = (type(node.source) == "string") and node.source:sub(1, 100000)
			or ('print("Hello from ' .. node.class .. '")\n')
	else
		inst = Instance.new(node.class)
	end
	for k, v in pairs(cls.defaults or {}) do pcall(function() inst[k] = v end) end
	local props = type(node.props) == "table" and node.props or {}
	for _, def in ipairs(cls.props) do
		local raw = props[def.name]
		if raw ~= nil then
			local okd, val = pcall(DEC[def.kind], raw, def)
			if okd and val ~= nil then
				if def.name == "Name" then
					val = (val:gsub("^_+", "")):sub(1, 40)
					if val == "" then val = node.class end
				end
				pcall(function() inst[def.name] = val end)
			end
		end
	end
	local animation = node.animate or node.animation
	if type(animation) == "string" and (animation == "Float" or animation == "Pulse" or animation == "Spin" or animation == "Float + Pulse") then
		inst:SetAttribute("BAnimation", animation)
	end
	inst.Parent = parent
	if applyBuilderAnimation then pcall(applyBuilderAnimation, inst) end
	if type(node.children) == "table" then
		for _, ch in ipairs(node.children) do buildNode(ch, inst, depth + 1) end
	end
	return inst
end

-- ================= GUI TO LUA (no locals, so big GUIs never hit Lua's 200-local limit) =================
local function luaLiteral(def, v)
	local k = def.kind
	if k == "string" then return string.format("%q", v) end
	if k == "bool" or k == "number" then return tostring(v) end
	if k == "color" then return string.format("Color3.fromRGB(%d, %d, %d)", v[1], v[2], v[3]) end
	if k == "udim2" then return string.format("UDim2.new(%s, %s, %s, %s)", v[1], v[2], v[3], v[4]) end
	if k == "udim" then return string.format("UDim.new(%s, %s)", v[1], v[2]) end
	if k == "vector2" then return string.format("Vector2.new(%s, %s)", v[1], v[2]) end
	if k == "enum" then return "Enum." .. tostring(def.enum) .. "." .. tostring(v) end
	if k == "gradient" then
		local parts = {}
		for _, p in ipairs(v) do
			parts[#parts + 1] = string.format("ColorSequenceKeypoint.new(%s, Color3.fromRGB(%d, %d, %d))", p[1], p[2], p[3], p[4])
		end
		return "ColorSequence.new({ " .. table.concat(parts, ", ") .. " })"
	end
	return "nil"
end

