		else
			aiMode = "Chat"
			modeBtn.Text = "Mode: Chat"
			modeBtn.TextColor3 = TEXT
			input.PlaceholderText = "Message the AI..."
			addLine("Chat mode ON — safe, GUI will not change.", SUB, false)
		end
	end)

	local function runBuild(request)
		local ok, encoded = pcall(function() return HttpService:JSONEncode(serializeChildren(projectGui)) end)
		local ctx = (ok and type(encoded) == "string" and #encoded > 2) and encoded:sub(1, 10000) or ""
		local userText = (ctx ~= "" and ("Existing GUI context: " .. ctx .. "\n") or "")
			.. "Add useful new elements (do not wipe unrelated existing ones unless asked).\nRequest: " .. request
		local reply, err = Shared.gemini(AI_BUILD_SYSTEM, userText, 8192)
		if not reply then return false, tostring(err or "No reply") end
		local jsonText = tostring(reply):match("{.*}")
		if not jsonText then return false, "No GUI JSON in reply. Try a clearer build request." end
		local okj, data = pcall(function() return HttpService:JSONDecode(jsonText) end)
		if not okj or type(data) ~= "table" then return false, "Could not read GUI JSON." end
		local nodes = data.children
		if type(nodes) ~= "table" then
			if data.class then nodes = { data } else return false, "No elements in reply." end
		end
		buildCount = 0
		local first
		for _, n in ipairs(nodes) do
			local inst = buildNode(n, projectGui, 1)
			if inst and not first then first = inst end
		end
		if not first then return false, "Nothing was built." end
		if refreshExplorer then refreshExplorer() end
		return true, buildCount, first
	end

	local function sendRequest()
		if busy then return end
		local req = input.Text:match("^%s*(.-)%s*$") or ""
		if req == "" then return end
		if not hasPremium() then
			addLine("AI Coder is a Premium feature.", GOLD, false)
			return
		end
		local okSpend, cost = Shared.spendTokens()
		if not okSpend then
			addLine(string.format("Out of tokens (need ~%.2f, have %.2f). Refills in 2–4 hours.", cost or 1, Shared.tokens), RED, false)
			Shared.playTokenEmptyAnim(aiBody)
			return
		end
		req = req:sub(1, 800)
		input.Text = ""
		busy = true
		send.Text = "..."
		addLine(req, ACCENT, true)
		local status = addLine(aiMode == "Build" and "Building..." or "Thinking...", SUB, false)
		task.spawn(function()
			if aiMode == "Build" then
				local ok, a, b, c = pcall(runBuild, req)
				busy = false
				send.Text = "Send"
				if not ok then
					status.Text = "Error: " .. tostring(a)
					status.TextColor3 = RED
				elseif a == true then
					status.Text = "Built " .. tostring(b) .. " element(s) into your GUI."
					status.TextColor3 = GREEN
					if c and selectInstance then selectInstance(c) end
				else
					status.Text = "Could not build: " .. tostring(b)
					status.TextColor3 = RED
				end
			else
				local ctx = ""
				for i = math.max(1, #history - 5), #history do
					local h = history[i]
					if h then ctx = ctx .. h.role .. ": " .. h.text .. "\n" end
				end
				local userText = (ctx ~= "" and ("Recent chat:\n" .. ctx .. "\n") or "") .. "User: " .. req
				local reply, err = Shared.gemini(AI_CHAT_SYSTEM, userText, 2048)
				busy = false
				send.Text = "Send"
				if reply then
					local clean = tostring(reply):gsub("[%z\1-\8\11-\31]", ""):sub(1, 4000)
					status.Text = clean
					status.TextColor3 = TEXT
					history[#history + 1] = { role = "user", text = req }
					history[#history + 1] = { role = "assistant", text = clean }
					while #history > 20 do table.remove(history, 1) end
				else
					status.Text = "Error: " .. tostring(err or "No reply")
					status.TextColor3 = RED
				end
			end
			task.defer(function()
				task.wait()
