local function addElement(className)
	if not CLASSES[className] then return end
	counter += 1
	buildCount = 0
	local parent = addTarget or container()
	if not parent or (not parent.Parent and parent ~= projectGui) then parent = projectGui end
	-- place at the bottom of siblings (Studio-style)
	local maxOrder = 0
	for _, ch in ipairs(parent:GetChildren()) do
		if ch:IsA("GuiObject") and typeof(ch.LayoutOrder) == "number" then
			if ch.LayoutOrder > maxOrder then maxOrder = ch.LayoutOrder end
		end
	end
	local inst = buildNode({ class = className, props = { Name = className .. counter, LayoutOrder = maxOrder + 1 } }, parent, 1)
	if inst and inst:IsA("GuiObject") then
		pcall(function() inst.LayoutOrder = maxOrder + 1 end)
	end
	addTarget = nil
	if inst then selectInstance(inst) end
end
