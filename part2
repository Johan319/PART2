        for key = #Shared.RANK_NAMES, 0, -1 do
            local list = groups[key]
            if list then
                table.sort(list, function(a, b)
                    if a.tag ~= b.tag then return TAG_ORDER[a.tag] < TAG_ORDER[b.tag] end
                    return tostring(a.name or a.uid) < tostring(b.name or b.uid)
                end)
                header(key == 0 and "Premium" or Shared.RANK_NAMES[key])
                for _, e in ipairs(list) do addRow(e) end
            end
        end
    end

