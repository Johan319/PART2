        end
    end

    -- hide every page except the two in the transition (no bleed)
    hideOtherPages(oldPage, newPage)
    currentTab = name
    if name ~= "Info Players" then
        pcall(closeExpanded)
    end
    if oldPage and oldPage ~= newPage then
        fadeOutPage(oldPage, function()
            if currentTab == name then
                hideOtherPages(newPage, nil)
                fadeInPage(newPage)
            end
        end)
    else
        hideOtherPages(newPage, nil)
        fadeInPage(newPage)
    end
end

